# ==============================================================================
# Wanderlust — Environment Variables Configuration
# ==============================================================================
# For local development: copy this file to `.env` and fill in values.
# For Vercel deployment: configure these environment variables in the Vercel project dashboard.
#
# IMPORTANT SECURITY RULES:
# 1. Variables prefixed with `VITE_` or referenced in client components are bundled
#    into the browser-downloadable JavaScript.
# 2. Never put secret keys (such as `SUPABASE_SERVICE_ROLE_KEY`) into `VITE_` variables!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Credentials (CLIENT-SAFE)
# ------------------------------------------------------------------------------
# Used for browser-side authentication and public SSR catalog queries with RLS enforcement.

# Supabase Project REST / Auth API Gateway URL
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous / Publishable Key (Client-Safe, protected by Postgres RLS)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_anon_key_here"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_anon_key_here"

# Supabase Project ID identifier
SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_PROJECT_ID="your_project_id_here"

# ------------------------------------------------------------------------------
# 2. Supabase Server-Only Credentials (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Used exclusively inside trusted server functions / backend tasks.
# Bypasses Row Level Security (RLS) — do NOT add to client builds.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

